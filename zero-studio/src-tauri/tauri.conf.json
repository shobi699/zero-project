{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Zero Studio",
  "version": "0.1.0",
  "identifier": "com.zero.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zero Studio",
        "width": 800,
        "height": 600
      },
      {
        "label": "preview",
        "title": "Interactive Preview",
        "width": 512,
        "height": 380,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "url": "/?window=preview"
      },
      {
        "label": "widget",
        "title": "Floating Voice Widget",
        "width": 450,
        "height": 450,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "url": "/?window=widget"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/zero-daemon"
    ],
    "resources": [
      "scripts/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": true,
        "languages": ["English"]
      }
    },
    "category": "Productivity",
    "shortDescription": "System-wide Persian voice input for Windows",
    "longDescription": "Zero is a system-wide voice input layer for Windows. Press a hotkey anywhere, speak, and transcribed text is inserted at the cursor."
  }
}
